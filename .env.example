DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# AI (optional) - OpenAI-compatible endpoint. Defaults target Ollama.
OPENAI_KEY=""
OPENAI_BASE_URL="https://ollama.com/v1"
OPENAI_MODEL="deepseek-v4.1-flash:1017"
OPENAI_VISION_MODEL="deepseek-v4.1-flash:1017"

# App default language: en, de, es (runtime; user preferences take priority)
DEFAULT_LOCALE="en"
